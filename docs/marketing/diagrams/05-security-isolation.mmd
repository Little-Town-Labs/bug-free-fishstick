---
config:
  theme: base
  themeVariables:
    primaryColor: "#0B1B3B"
    primaryTextColor: "#F8FAFC"
    primaryBorderColor: "#FF6B35"
    lineColor: "#3B82F6"
    fontFamily: "Inter, sans-serif"
---
flowchart TB

---
config:
  theme: base
  themeVariables:
    primaryColor: "#0B1B3B"
    primaryTextColor: "#F8FAFC"
    primaryBorderColor: "#FF6B35"
    lineColor: "#3B82F6"
    fontFamily: "Inter, sans-serif"
---
flowchart TB
    U["👥 Your Team<br/><br/>Sales • Marketing • SMEs"]:::user
    subgraph APP["RocketRFP Platform"]
        direction TB
        UI["🖥️ Drafting Canvas<br/>& Dashboard"]:::ui
        AI["🤖 AI Agents<br/>Intake • Draft • QA"]:::ai
        KB["🧠 Your Private<br/>Knowledge Base"]:::kb
        UI <--> AI
        AI <--> KB
    end
    LLM["🔌 LLM Providers<br/><br/>Claude • GPT<br/>or Local/Private"]:::ext
    INT["🔗 Integrations<br/><br/>Slack • CRM<br/>Procurement portals"]:::ext
    DOC["📄 RFP Documents<br/>PDF • Word • Web"]:::ext
    OUT["✅ Completed<br/>Proposal"]:::out
    U <--> UI
    DOC --> AI
    AI <--> LLM
    APP <--> INT
    UI --> OUT
    classDef user fill:#3B82F6,stroke:#0B1B3B,color:#fff,stroke-width:2px
    classDef ui fill:#F8FAFC,stroke:#0B1B3B,color:#0B1B3B,stroke-width:2px
    classDef ai fill:#F8FAFC,stroke:#0B1B3B,color:#0B1B3B,stroke-width:2px
    classDef kb fill:#0B1B3B,stroke:#FF6B35,color:#F8FAFC,stroke-width:2px
    classDef ext fill:#F8FAFC,stroke:#64748B,color:#1E293B,stroke-width:1px,stroke-dasharray:4 3
    classDef out fill:#FF6B35,stroke:#0B1B3B,color:#fff,stroke-width:2px
    style APP fill:#F8FAFC,stroke:#0B1B3B,color:#0B1B3B
